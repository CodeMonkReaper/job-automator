# Variables opcionales para Job Automator
# Copia este archivo como .env (ignorado por Git)

# Clave opcional para generación en vivo con Gemini API (si se omite, usa síntesis determinista)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Rutas portables (por defecto resuelven dentro de la raíz del proyecto)
JOB_AUTOMATOR_WORKSPACE=
JOB_AUTOMATOR_CONFIG_DIR=
JOB_AUTOMATOR_DATA_DIR=
JOB_AUTOMATOR_OUTPUT_DIR=
JOB_AUTOMATOR_CVS_DIR=
JOB_AUTOMATOR_DB_PATH=

# Configuración de Chrome CDP
JOB_AUTOMATOR_CDP_PORT=9222
JOB_AUTOMATOR_CHROME_DEBUG_DIR=
